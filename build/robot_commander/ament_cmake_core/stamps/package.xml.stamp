<?xml version="1.0"?>

<package format="3">

  <name>robot_commander</name>

  <version>0.1.0</version>

  <description>
    MoveIt command interface for the SPOT robot arm.
  </description>

  <maintainer email="msd@example.com">
    msd
  </maintainer>

  <license>Apache-2.0</license>


  <buildtool_depend>
    ament_cmake
  </buildtool_depend>


  <depend>
    rclcpp
  </depend>

  <depend>
    geometry_msgs
  </depend>

  <depend>
    std_msgs
  </depend>

  <depend>
    moveit_ros_planning_interface
  </depend>


  <export>

    <build_type>
      ament_cmake
    </build_type>

  </export>

</package>
