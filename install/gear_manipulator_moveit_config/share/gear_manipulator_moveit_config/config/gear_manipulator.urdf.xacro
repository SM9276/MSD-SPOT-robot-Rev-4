<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="gear_manipulator">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import gear_manipulator urdf file -->
    <xacro:include filename="$(find my_robot)/urdf/gear_manipulator.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="gear_manipulator.ros2_control.xacro" />


    <xacro:gear_manipulator_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
